# Restaurant Cloud · environment
# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any real secret.

# Public Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://msxsdcneuxvcxmygquvr.supabase.co

# Public/publishable key. This is NOT enough for admin writes because RLS is on.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_HsPJhInbQbWS_90TONda7w_6f5MqNvI

# Server-side Supabase project URL (optional; falls back to the public URL above).
SUPABASE_URL=https://msxsdcneuxvcxmygquvr.supabase.co

# Server-only service role key. Get it from Supabase → Project Settings → API Keys.
# Give this key a name, keep it out of git, and never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Local development only. Uses cloud/data/cloud.db when Supabase is not configured.
# Set to 1 locally; leave unset/0 in production.
CLOUD_LOCAL_STORE=0
CLOUD_DB_PATH=./data/cloud.db

# Vendor console login.
ADMIN_PASSWORD=admin123

# HMAC secret for the admin session cookie. Generate a long random value.
ADMIN_SECRET=replace-with-a-long-random-string

# Shown in the restaurant billing popup.
SUPPORT_PHONE=+91 90000 00000
SUPPORT_EMAIL=support@restaurantos.local
